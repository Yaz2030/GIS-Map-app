# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة (مثلاً عند ربط خادم proxy خاص)
VITE_NOMINATIM_API=https://nominatim.openstreetmap.org
VITE_OSRM_API=https://router.project-osrm.org/route/v1/driving

# اختياري: مفتاح Stadia Maps لطبقة "Alidade Smooth Dark". يعمل بدون مفتاح على
# localhost ضمن الحد المجاني، ويُنصح بإضافته عند النشر على نطاق حقيقي.
VITE_STADIA_API_KEY=
