{
  "info": {
    "_postman_id": "b7e1f2a0-4c3d-4e9a-9b1a-6f2d8a7c5e10",
    "name": "mapbackend - Demo Collection",
    "description": "Demo walkthrough: registration validation, email verification gate, and admin authorization rules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register - Weak Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Weak Password Demo\",\n  \"email\": \"weak_password_demo@example.com\",\n  \"password\": \"weakpass\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Expected: 400. Password fails @StrongPassword (no uppercase, no special character)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Register - Strong Password",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo_user@example.com\",\n  \"password\": \"Demo@Pass123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Expected: 200. Password satisfies @StrongPassword. Response is a safe profile (id/name/email/role) with no password or tokens. A verification email is sent; the account is not yet verified."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Login Before Verification",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo_user@example.com\",\n  \"password\": \"Demo@Pass123\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "login"]
        },
        "description": "Expected: 403. The account from the previous request has not verified its email yet, so login is blocked."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get Profile Without Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        },
        "description": "Expected: 401. No Authorization header is sent."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Admin Route with Regular User Token",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{userToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users"]
        },
        "description": "Expected: 403. Fill {{userToken}} with a token from a logged-in, verified, non-admin account (ROLE_USER). The /api/admin/** routes require ROLE_ADMIN."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Get All Users - Admin (Pagination)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users?page=0&size=5",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users"],
          "query": [
            { "key": "page", "value": "0" },
            { "key": "size", "value": "5" }
          ]
        },
        "description": "Expected: 200. Fill {{adminToken}} with a token from the admin account. Returns a standard Spring Data Page (content, totalElements, totalPages, ...)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Admin Delete Own Account",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users/{{adminUserId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users", "{{adminUserId}}"]
        },
        "description": "Expected: 403. Fill {{adminUserId}} with the admin's own user id (from GET /api/users/me while logged in as admin). Admins are blocked from deleting their own account."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Admin Delete Another User",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/admin/users/{{targetUserId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "admin", "users", "{{targetUserId}}"]
        },
        "description": "Expected: 200. Fill {{targetUserId}} with the id of a different (non-admin) user to delete, e.g. the id returned by the 'Register - Strong Password' request above."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "userToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "adminUserId", "value": "", "type": "string" },
    { "key": "targetUserId", "value": "", "type": "string" }
  ]
}
